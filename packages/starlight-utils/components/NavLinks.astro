---
/**
 * Server-rendered header links with ancestor-active logic.
 * Props: links: Array<{ label: string; href: string }>
 */
type Link = { label: string; href: string };
const { links = [] } = Astro.props as { links: Link[] };

const norm = (s: string) => (s?.endsWith("/") ? s : s + "/");
const current = norm(Astro.url.pathname);

// Pick the longest href that prefixes the current path
let bestHref: string | null = null;
for (const l of links) {
    const h = norm(l.href);
    if (h !== "/" && current.startsWith(h)) {
        if (!bestHref || h.length > norm(bestHref).length) bestHref = l.href;
    }
}
const isActive = (href: string) => bestHref && norm(href) === norm(bestHref);
---

<ul class="slu-nav-links">
    {
        links.map((l) => (
            <li>
                <a
                    href={l.href}
                    aria-current={isActive(l.href) ? "true" : "false"}
                >
                    {l.label}
                </a>
            </li>
        ))
    }
</ul>

<style>
    .slu-nav-links {
        display: inline-flex;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .slu-nav-links a[aria-current="true"] {
        font-weight: 600;
    }
</style>
