---
/**
 * Robust NavLinks — accepts either:
 *  • { links: Array<{ label: string; href?: string; link?: string }> }
 *  • { items: Array<{ label: string; href?: string; link?: string }> }  <-- what the plugin may pass
 * Normalizes to [{ label, href }] and applies longest-prefix ancestor-active logic.
 */
type Raw = { label: string; href?: string; link?: string };
const { links: propLinks = [], items: propItems = [] } = Astro.props as {
  links?: Raw[];
  items?: Raw[];
};

const raw: Raw[] =
  (Array.isArray(propLinks) && propLinks.length ? propLinks : propItems) ?? [];

// Normalize
type Link = { label: string; href: string };
const normalized: Link[] = raw
  .map((r) => ({
    label: r?.label ?? "",
    href: (r?.href ?? r?.link ?? "").trim(),
  }))
  .filter((r) => r.label && r.href);

// Ancestor-active (longest prefix)
const norm = (s: string) => (s?.endsWith("/") ? s : s + "/");
const current = norm(Astro.url.pathname);

let bestHref: string | null = null;
for (const l of normalized) {
  const h = norm(l.href);
  if (h !== "/" && current.startsWith(h)) {
    if (!bestHref || h.length > norm(bestHref).length) bestHref = l.href;
  }
}
const isActive = (href: string) => bestHref && norm(href) === norm(bestHref);
---

<ul class="slu-nav-links">
  {
    normalized.map((l) => (
      <li>
        <a href={l.href} aria-current={isActive(l.href) ? "true" : "false"}>
          {l.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .slu-nav-links {
    display: inline-flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .slu-nav-links a[aria-current="true"] {
    font-weight: 500;
  }
</style>
